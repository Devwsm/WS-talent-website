# Contoh .env untuk SERVER (produksi / preview). Salin ke .env di server, lalu isi semua nilai bertanda GANTI.
# Jangan pernah meng-commit .env asli. Kunci dan sandi di bawah ini harus berbeda di tiap server.

APP_NAME="Whisnu Santika"
APP_ENV=production
APP_KEY=                      # GANTI: isi dengan `php artisan key:generate --show` (jalankan di komputer lokal)
APP_DEBUG=false               # WAJIB false di server (true membocorkan isi .env dan kode lewat halaman galat)
APP_URL=https://whisnusantika.com   # GANTI per domain (preview: https://preview.whisnusantika.com), WAJIB https
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=                  # GANTI: satu database terpisah per domain
DB_USERNAME=                  # GANTI: user database khusus (bukan root), hak akses hanya ke database ini
DB_PASSWORD=                  # GANTI: sandi kuat

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true    # cookie sesi hanya lewat HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Isi hanya bila situs ada di belakang proxy/CDN (mis. Cloudflare). Kosong = tidak ada proxy.
TRUSTED_PROXIES=

# Akun admin CMS pertama (dipakai `php artisan db:seed` / seeder accountSeeder). Sandi minimal 12 karakter.
ADMIN_USERNAME=               # GANTI
ADMIN_PASSWORD=               # GANTI

# WS Inner Circle. Biarkan false sampai tabel database, jadwal acara, dan hadiah siap (lihat README, bagian Rilis).
INNER_CIRCLE_AKTIF=false
IC_SEED_CONTOH=false          # jangan true di server

# Email (lupa kata sandi dan notifikasi Inner Circle) lewat SMTP Gmail. Selama MAIL_MAILER=log, email TIDAK terkirim (hanya ditulis ke log).
# Siapkan di akun Google pengirim (mis. akun IT WSM): aktifkan Verifikasi 2 Langkah, lalu buat Sandi Aplikasi di
# https://myaccount.google.com/apppasswords. Sandi Aplikasi (16 huruf) diisi ke MAIL_PASSWORD, BUKAN sandi login Google. Tulis tanpa spasi.
# SMTP Gmail memakai Sandi Aplikasi, bukan OAuth, jadi GOOGLE_CLIENT_ID/SECRET (login anggota) tidak ikut dipakai untuk email.
# MAIL_FROM_ADDRESS wajib sama dengan MAIL_USERNAME; Gmail menimpa alamat pengirim lain kecuali sudah didaftarkan sebagai alias "Kirim sebagai".
# Port 465 = MAIL_SCHEME=smtps, port 587 = MAIL_SCHEME=smtp.
MAIL_MAILER=log               # ganti ke smtp bila sudah siap kirim sungguhan
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
